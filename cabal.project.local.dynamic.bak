import: cabal/dev-sh.project.local

-- Linux lib paths (conda)
package *
  extra-lib-dirs: /mnt/arthur/miniforge3/lib
  extra-include-dirs: /mnt/arthur/miniforge3/include

package postgresql-libpq
  extra-include-dirs: /mnt/arthur/miniforge3/include
  extra-lib-dirs: /mnt/arthur/miniforge3/lib

package pg-client
  extra-include-dirs: /mnt/arthur/miniforge3/include
  extra-lib-dirs: /mnt/arthur/miniforge3/lib

-- Allow newer hashtables to avoid gcc 15 incompatibility in 1.3.1
allow-newer: hashtables
